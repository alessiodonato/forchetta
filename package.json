{
  "name": "forchetta",
  "version": "0.7.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Centro di controllo locale per sessioni Claude Code parallele su macOS.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "build:app": "sh scripts/build-app.sh",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "preact": "11.2.0",
    "ws": "8.22.2"
  }
}
