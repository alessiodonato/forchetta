#!/bin/sh
# Forchetta CLI. Resolves its real location, so that a symbolic link in the PATH works too.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(dirname "$self")/..
# docs/install.sh puts a Node.js here on a Linux without one (or with an old one): not in the PATH, only for Forchetta.
# Never on a Mac.
if [ ! -d /System/Library/CoreServices ] && [ -x "$root/../forchetta-node/bin/node" ]; then
  exec "$root/../forchetta-node/bin/node" "$root/dist/cli.js" "$@"
fi
exec node "$root/dist/cli.js" "$@"
