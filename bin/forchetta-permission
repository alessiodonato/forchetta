#!/bin/sh
# Hook of Forchetta for PermissionRequest. Like forchetta-hook it sends the request to the local daemon; for an
# interactive session it then waits until the box answers it. Claude Code shows its own dialog at the same time
# (seen with 2.1.322): whichever answers first wins, and a late answer is ignored. When the dialog gets "No" or
# Esc in the terminal, Claude Code ends this hook, and the daemon sees the connection close.
#
# What it prints is the decision, as Claude Code reads it on stdout. Daemon off, no ticket, any error: it prints
# nothing and exits 0, and the dialog goes on as usual. The hook timeout in settings.json must be longer than
# the wait (second argument, in seconds).
# The private folder of Forchetta, by the rule of src/shared/paths.ts: the daemon listens for the hooks on a socket
# there (0700, so no other user or app can be in its place).
root=$(cd "$(dirname "$0")/.." && pwd -P)
if [ -n "${FORCHETTA_VAR:-}" ]; then
  data=$FORCHETTA_VAR
elif [ -e "$root/.git" ]; then
  data="$root/var"
else
  data="$HOME/Library/Application Support/Forchetta"
fi
socket="$data/hooks.sock"
# A daemon from before the socket (0.9.12 and older) listens for the hooks on its port: the port, until it is
# restarted. Once a newer daemon has run in this folder (it writes data-version), only the socket, also when the
# daemon is off: nobody can stand in its place.
port=${1:-47821}
if [ -S "$socket" ] || [ -e "$data/data-version" ]; then
  via=--unix-socket target=$socket base=http://localhost
else
  via=--noproxy target='*' base="http://127.0.0.1:$port"
fi
limit=${2:-3540}
child=
trap 'if [ -n "$child" ]; then kill "$child" 2>/dev/null; fi; exit 0' HUP INT TERM
ticket=$(/usr/bin/curl --silent --max-time 2 "$via" "$target" \
  --header 'Content-Type: application/json' \
  --header "X-Forchetta-Pid: ${PPID:-}" \
  --header "X-Forchetta-Claude-Pid: ${CLAUDE_PID:-}" \
  --header "X-Forchetta-Pane: ${TMUX_PANE:-}" \
  --header "X-Forchetta-Agent: ${FORCHETTA_AGENT:-}" \
  --header "X-Forchetta-Wait: $limit" \
  --data-binary @- "$base/forchetta/permission" 2>/dev/null) || exit 0
case "$ticket" in
  '' | *[!0-9a-f]*) exit 0 ;;
esac
/usr/bin/curl --silent --max-time "$limit" "$via" "$target" "$base/forchetta/permission/$ticket" 2>/dev/null &
child=$!
wait "$child"
exit 0
